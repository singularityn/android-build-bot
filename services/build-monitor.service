[Unit]
Description=Android Build Web Monitor (ttyd)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/evolution
ExecStart=/usr/bin/ttyd -p 8080 -R -c user:singularity tmux attach-session -t build -r
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
